# ============================================================
# 环境变量配置示例
# 复制此文件为 .env 并填写真实值，.env 已在 .gitignore 中忽略

# 所有账号、密码、Token 等敏感变量必须通过本地 .env 或 CI Secret 注入，示例文件不提供默认明文值
# ============================================================

# ============================================================
#  一、通知派发开关
# ============================================================
# 通知方式：0=不发送, 1=仅钉钉, 2=仅企业微信, 3=仅邮件, 4=全部发送
# 引用位置：config/settings.py:60
SEND_RESULT_TYPE=4


# ============================================================
#  二、邮件通知（SEND_RESULT_TYPE 含 3 或 4 时启用）
# ============================================================
# 发件人邮箱
EMAIL_USER=your_email@example.com

# 发件人邮箱 SMTP 授权码（不是登录密码！）
# QQ 邮箱：设置 → 账户 → 开启 SMTP 服务 → 获取授权码
# 163 邮箱：设置 → POP3/SMTP/IMAP → 开启服务 → 获取授权码
EMAIL_PASSWORD=your_smtp_auth_code

# SMTP 服务器地址
# QQ 邮箱: smtp.qq.com
# 163 邮箱: smtp.163.com
# Gmail:   smtp.gmail.com
# 企业邮箱: 咨询管理员
EMAIL_HOST=smtp.qq.com

# 收件人邮箱（多个用英文逗号分隔，不要带空格）
EMAIL_TO=receiver1@example.com,receiver2@example.com


# ============================================================
#  三、钉钉通知（SEND_RESULT_TYPE 含 1 或 4 时启用）
# ============================================================
# 钉钉群机器人 webhook URL
# 获取：钉钉群 → 群设置 → 智能群助手 → 添加机器人 → 自定义
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx

# 钉钉群机器人加签密钥（启用加签时必填）
DINGTALK_SECRET=SECxxxxxxxxxxxxxxxxxxxxxx


# ============================================================
#  四、企业微信通知（SEND_RESULT_TYPE 含 2 或 4 时启用）
# ============================================================
# 企业微信群机器人 webhook URL
# 获取：企业微信群 → 右键 → 添加群机器人
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx


# ============================================================
#  五、Clue 项目账号（必填：请通过本地 .env 或 CI Secret 注入真实值）
# ============================================================
# Clue 系统超级管理员用户名
CLUE_ADMIN_USER=

# Clue 系统超级管理员密码
CLUE_ADMIN_PASSWORD=

# Clue 创建账号用例使用的初始密码（未配置时该用例会被跳过）
CLUE_TEST_ACCOUNT_PASSWORD=


# ============================================================
#  六、CRM 项目账号（必填：请通过本地 .env 或 CI Secret 注入真实值）
# ============================================================
# CRM 系统管理员用户名
CRM_ADMIN_USER=

# CRM 系统管理员密码
CRM_ADMIN_PASSWORD=
